# Supabase — crea un proyecto en https://supabase.com y copia estos valores
# desde Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para uso en servidor (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor de IA — Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# Usado en el Connector Challenge para analizar tus respuestas.
AI_API_KEY=

# Opcional: fuerza una versión concreta de Gemini en vez del alias
# "gemini-flash-lite-latest" (recomendado, se auto-actualiza).
GEMINI_MODEL=
